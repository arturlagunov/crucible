{
  "name": "crucible-comments-demo",
  "displayName": "Crucible Comments",
  "description": "Painter для *-threads.json",
  "version": "0.2.5",
  "publisher": "onec-sandbox",
  "engines": { "vscode": "^1.85.0" },
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "crucibleCommentsDemo.load", "title": "Crucible: Load Threads JSON" },
      { "command": "crucibleCommentsDemo.paintActive", "title": "Crucible: Paint Active File" },
      { "command": "crucibleCommentsDemo.reply", "title": "Reply", "enablement": "!commentIsEmpty" },
      { "command": "crucibleCommentsDemo.resolve", "title": "Resolve", "icon": "$(check)" },
      { "command": "crucibleCommentsDemo.unresolve", "title": "Unresolve", "icon": "$(issues)" },
      { "command": "crucibleCommentsDemo.deleteComment", "title": "Delete", "icon": "$(trash)" },
      { "command": "crucibleCommentsDemo.deleteThread", "title": "Delete Thread", "icon": "$(trash)" },
      { "command": "crucibleCommentsDemo.save", "title": "Crucible: Save Threads JSON" },
      { "command": "crucibleCommentsDemo.clear", "title": "Crucible: Clear" },
      { "command": "crucibleCommentsDemo.copyUrl", "title": "Crucible: Copy URL" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "crucibleCommentsDemo.reply", "when": "false" },
        { "command": "crucibleCommentsDemo.resolve", "when": "false" },
        { "command": "crucibleCommentsDemo.unresolve", "when": "false" },
        { "command": "crucibleCommentsDemo.deleteComment", "when": "false" },
        { "command": "crucibleCommentsDemo.deleteThread", "when": "false" }
      ],
      "comments/commentThread/title": [
        {
          "command": "crucibleCommentsDemo.resolve",
          "group": "inline@1",
          "when": "commentController == crucible-comments && commentThread =~ /canResolve/"
        },
        {
          "command": "crucibleCommentsDemo.unresolve",
          "group": "inline@2",
          "when": "commentController == crucible-comments && commentThread =~ /canUnresolve/"
        },
        {
          "command": "crucibleCommentsDemo.deleteThread",
          "group": "inline@3",
          "when": "commentController == crucible-comments && commentThread =~ /canDeleteThread/"
        }
      ],
      "comments/comment/title": [
        {
          "command": "crucibleCommentsDemo.deleteComment",
          "group": "inline@1",
          "when": "commentController == crucible-comments && comment =~ /canDelete/"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "crucibleCommentsDemo.reply",
          "group": "inline",
          "when": "commentController == crucible-comments && !commentThreadIsEmpty"
        }
      ]
    },
    "keybindings": [
      {
        "command": "crucibleCommentsDemo.paintActive",
        "key": "alt+;",
        "when": "editorTextFocus"
      }
    ]
  }
}
